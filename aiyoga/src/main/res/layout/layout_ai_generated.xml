<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="56dp"
        android:paddingBottom="6dp">

    <!-- ================= CHAT BUBBLE ================= -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">

        <ImageView
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/shape_circle"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/chatbot" />

        <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

            <TextView
                    android:id="@+id/tv_ai_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/_240sdp"
                    android:minWidth="@dimen/_50sdp"
                    android:fontFamily="@font/font_bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Tôi đã tạo cho bạn một bài tập phù hợp 👇"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/_13sdp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ================= CARD KẾT QUẢ ================= -->
    <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_240sdp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_6sdp"
            app:cardCornerRadius="@dimen/_16sdp"
            app:cardElevation="@dimen/_2sdp"
            app:strokeColor="#E5DFFF"
            app:strokeWidth="1dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp">

            <!-- CALORIES -->
            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F3EEFF"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_4sdp">

                <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:src="@drawable/ic_calo"
/>

                <TextView
                        android:id="@+id/tvCaloriesValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:text="125 kcal"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_11sdp"
                        android:fontFamily="@font/font_bold"/>
            </LinearLayout>

            <!-- LIST POSE -->
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_ai_poses"
                    android:layout_width="match_parent"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:maxHeight="@dimen/_180sdp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_ai_pose_mini"
                    tools:itemCount="3"/>

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_ai_sequence"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.5"
                    android:text="Lưu"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/font_bold"
                    android:background="@drawable/bg_btn_create"
                    app:backgroundTint="@null"
                    app:cornerRadius="@dimen/_10sdp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/_4sdp"
                    app:iconTint="@android:color/white" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>