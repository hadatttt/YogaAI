<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/guide">

    <View
            android:id="@+id/bottom_overlay"
            android:layout_width="0dp"
            android:layout_height="@dimen/_260sdp"
            android:background="@drawable/bg_guide_bottom_overlay"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <TextView
            android:id="@+id/tv_guide"
            android:layout_width="@dimen/_240sdp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_24sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:fontFamily="@font/font_bold"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:lineSpacingExtra="@dimen/_4sdp"
            android:text="@string/ai_camera_guide_text"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_26ssp"
            app:layout_constraintBottom_toTopOf="@id/btn_next"
            app:layout_constraintEnd_toEndOf="parent" />

    <TextView
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_24sdp"
            android:layout_marginBottom="@dimen/_42sdp"
            android:background="@drawable/bg_btn_create"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_bold"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_54sdp"
            android:text="@string/next"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_24ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>