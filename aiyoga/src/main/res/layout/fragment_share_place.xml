<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F9F9F9">

    <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:background="@drawable/shape_circle"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_bold"
            android:text="@string/share_practice_spot"
            android:textColor="@color/purple_500"
            android:textSize="@dimen/_20sdp"
            app:layout_constraintBottom_toBottomOf="@id/iv_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_back" />

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_100sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_back">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                    android:id="@+id/card_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    app:cardCornerRadius="@dimen/_16sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F2F2F2"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                    <ImageView
                            android:id="@+id/img_yoga_pose"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                    <com.hadat.aiyoga.utils.view.OverlayViewImage
                            android:id="@+id/overlay_result"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                        <ImageView
                                android:id="@+id/iv_camera_capture"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_margin="@dimen/_12sdp"
                                android:background="@drawable/shape_circle_gray"
                                android:elevation="@dimen/_4sdp"
                                android:outlineProvider="background"
                                android:padding="@dimen/_6sdp"
                                android:src="@drawable/ic_camera"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                        <ImageView
                                android:id="@+id/iv_crop"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                android:background="@drawable/shape_circle_gray"
                                android:elevation="@dimen/_4sdp"
                                android:outlineProvider="background"
                                android:padding="@dimen/_8sdp"
                                android:src="@drawable/ic_crop"
                                app:layout_constraintBottom_toBottomOf="@id/iv_camera_capture"
                                app:layout_constraintEnd_toStartOf="@id/iv_camera_capture"
                                app:layout_constraintTop_toTopOf="@id/iv_camera_capture" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_ai"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_100sdp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/card_image"
                    app:layout_constraintEnd_toEndOf="@id/card_image"
                    app:layout_constraintStart_toStartOf="@id/card_image"
                    app:layout_constraintTop_toTopOf="@id/card_image"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/ai" />

            <TextView
                    android:id="@+id/tv_ai_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:fontFamily="@font/font_bold"
                    android:text="@string/ai_analyzing"
                    android:textColor="@color/purple_500"
                    android:textSize="@dimen/_14ssp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="@+id/lottie_ai"
                    app:layout_constraintStart_toStartOf="@+id/lottie_ai"
                    app:layout_constraintTop_toBottomOf="@+id/lottie_ai" />

            <ImageView
                    android:id="@+id/ic_level"
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/ic_image"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/primary"
                    tools:layout_editor_absoluteY="472dp"
                    app:layout_constraintTop_toBottomOf="@id/card_image"
                    tools:layout_editor_absoluteX="16dp" />

            <TextView
                    android:id="@+id/tv_level_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:text="@string/click_to_select_image"
                    android:fontFamily="@font/font_bold"
                    android:textColor="@color/primary"
                    app:layout_constraintTop_toTopOf="@id/ic_level"
                    app:layout_constraintBottom_toBottomOf="@id/ic_level"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintStart_toEndOf="@id/ic_level"
                    tools:layout_editor_absoluteY="469dp" />

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_images"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_16sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_level_label"
                    tools:listitem="@layout/item_image_thumb" />

            <ImageView
                    android:id="@+id/iv_desc_icon"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:src="@drawable/ic_help"
                    app:layout_constraintTop_toBottomOf="@id/rv_images"
                    app:tint="@color/primary"
                    tools:layout_editor_absoluteX="16dp" />

            <TextView
                    android:id="@+id/tv_desc_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/font_bold"
                    android:text="@string/cat_description"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintBottom_toBottomOf="@id/iv_desc_icon"
                    app:layout_constraintStart_toEndOf="@id/iv_desc_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_desc_icon" />

            <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/bg_search"
                    android:fontFamily="@font/font_regular"
                    android:gravity="top"
                    android:hint="@string/tell_us_about_your_practice_spot"
                    android:minLines="4"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_10sdp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_desc_label" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:background="@drawable/bg_btn_create"
            android:fontFamily="@font/font_bold"
            android:text="@string/share"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_14sdp"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>