<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Nền -->
    <solid android:color="#34C5AC" />
    <!-- Bo góc 10px ~ 10dp (thường dùng dp cho UI) -->
    <corners android:radius="10dp" />
    <!-- Viền 1px (mặc định để màu đen nhạt, có thể đổi) -->
    <stroke
        android:width="1dp"
        android:color="#1A000000" />
    <!-- Padding bên trong -->
    <padding
        android:left="8.46dp"
        android:top="8.46dp"
        android:right="8.46dp"
        android:bottom="8.46dp" />
</shape>
